# ============================================================================
# CALIBRO — Tatum x Walrus Memory "Total Recall" Hackathon Environment
# Copy to `.env.local` (git-ignored) and paste values after `=` (no quotes, no spaces),
# or run `npm run setup:keys` to create it. Never put real values in this file.
# ============================================================================

# --- 1. Walrus Memory Mainnet (@mysten-incubation/memwal) ---------------------
# Get both by running `npm run memwal:provision` or signing in at https://memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_DEFAULT_NAMESPACE=calibro:episodic

# Live Sui Mainnet contracts for Walrus Memory (from relayer /config)
MEMWAL_PACKAGE_ID=0xe7c16fbea0560e7057e2bf7422feaa4fb313749fc69c9e9092fac7a33b81d7f5
MEMWAL_REGISTRY_ID=0x8bf82c9e09e36b8d1c38298f68b7cb68e7b8762887e7592add9986d5e9cf199f

# There is no sandbox mode: without the two keys above the app is read-only.

# --- 2. Tatum Infrastructure (https://dashboard.tatum.io → API keys) ----------
TATUM_API_KEY=
# Tatum's Sui Mainnet gateway serves Sui GraphQL (the JSON-RPC root returns 404)
TATUM_SUI_MAINNET_GRAPHQL=https://sui-mainnet.gateway.tatum.io/graphql
TATUM_API_BASE_URL=https://api.tatum.io

# --- 3. Sui x402 / MPP Agent Payments (Sui Mainnet) ---------------------------
# Agent wallet that PAYS for signals (`suiprivkey1...`). Use a fresh wallet holding
# only a few SUI: each signal costs 0.002 SUI + gas.
CALIBRO_AGENT_SUI_PRIVATE_KEY=
# Treasury that RECEIVES signal fees (any Sui Mainnet address you control, 0x...)
CALIBRO_SIGNAL_TREASURY_ADDRESS=
# Native SUI: 0x2::sui::SUI
# Circle USDC on Sui: 0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC
CALIBRO_X402_COIN_TYPE=0x2::sui::SUI
# Signal price in base units (2_000_000 MIST = 0.002 SUI; for USDC 10000 = 0.01 USDC)
CALIBRO_X402_DEFAULT_PRICE_RAW=2000000

# --- 4. Server secrets (any long random string, e.g. `openssl rand -hex 32`) --
# Signs HTTP 402 challenges. If blank, a random one is generated per server restart.
CALIBRO_X402_CHALLENGE_SECRET=
# On a deployed LIVE app, evaluate/settle require header `x-calibro-admin: <token>`
# so public visitors cannot spend your SUI or write into your Walrus account.
CALIBRO_ADMIN_TOKEN=

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/settle (Vercel
# sets this automatically when you add the variable in the project settings).
CRON_SECRET=

# --- 5. Shared anti-replay ledger (REQUIRED on Vercel / any multi-instance host) -
# Upstash Redis REST (https://console.upstash.com) or Vercel KV (KV_REST_API_URL/_TOKEN).
# Locally, a file under .calibro/ is used when these are blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- 6. Market data ---------------------------------------------------------------
# Polymarket and ESPN need no key. The Odds API (https://the-odds-api.com) adds
# Pinnacle lines for upcoming games; past games use DraftKings via ESPN.
THE_ODDS_API_KEY=
